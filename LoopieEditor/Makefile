	cd /home/pols/Coding/LoopieEngine && $(MAKE) $(MAKESILENT) -f LoopieEditor/CMakeFiles/LoopieEditor.dir/build.make LoopieEditor/CMakeFiles/LoopieEditor.dir/src/Editor/Others/OrbitalCamera.cpp.i
.PHONY : src/Editor/Others/OrbitalCamera.cpp.i

src/Editor/Others/OrbitalCamera.s: src/Editor/Others/OrbitalCamera.cpp.s
.PHONY : src/Editor/Others/OrbitalCamera.s

